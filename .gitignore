# ==========================================
# 1. DEPENDENCIES (Node Modules)
# ==========================================
# This matches any node_modules folder at the root or deep inside subfolders
node_modules/
**/node_modules/

# ==========================================
# 2. ENVIRONMENT VARIABLES & SECRETS
# ==========================================
# Never, ever commit secret keys, database URIs, or passwords
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
**/backend/.env
**/frontend/.env

# ==========================================
# 3. PRODUCTION BUILDS & OUTPUTS
# ==========================================
# Frontend build directories (Vite/CRA / Next.js)
frontend/dist/
frontend/build/
frontend/out/
.next/

# Debug logs generated by npm/yarn errors
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================
# 4. SYSTEM & IDE FILES
# ==========================================
# Operating System specific files
.DS_Store
Thumbs.db
desktop.ini

# Code Editor configurations (uncomment if you want to push your VS Code settings)
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp